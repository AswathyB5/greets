<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 301 redirect non-www to www
RewriteCond %{HTTP_HOST} ^greetsequipment\.com$ [NC]
RewriteRule ^(.*)$ https://www.greetsequipment.com/$1 [R=301,L]

# 301 permanent redirect for all URLs containing /blogs/
# Removes /blogs/ and preserves the remaining path, stripping .html if present
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+blogs/(.*?)(?:\.html)?[\s?] [NC]
RewriteRule ^blogs/(.*)$ /%1/ [R=301,L]

# 301 permanent redirects for old .html URLs
# 301 redirect home page URLs carrying a query string (index.html?ind=dies etc.) to the clean home page
RewriteCond %{QUERY_STRING} .
RewriteRule ^index\.html$ /? [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+privacy\.html[\s?] [NC]
RewriteRule ^privacy\.html$ /privacy [R=301,L]

# 301 redirect every contact URL carrying a query string (?page=...&category=...&brand=...) to the clean /contact page
RewriteCond %{QUERY_STRING} .
RewriteRule ^contact(\.html)?/?$ /contact? [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+contact\.html[\s?] [NC]
RewriteRule ^contact\.html$ /contact [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+blog\.html[\s?] [NC]
RewriteRule ^blog\.html$ /blog [R=301,L]

# Internal rewrites to serve clean URLs without .html extension
RewriteRule ^privacy/?$ privacy.html [L]
RewriteRule ^contact/?$ contact.html [L]
RewriteRule ^blog/?$ blog.html [L]

# Fallback internal rewrites for blog posts if accessed as /page-name or /page-name/
RewriteRule ^medical-implant-cleaning-machine-india/?$ medical-implant-cleaning-machine-india/index.html [L]
RewriteRule ^vacuum-heat-treatment-furnace-india/?$ vacuum-heat-treatment-furnace-india/index.html [L]
RewriteRule ^pvd-coating-plant-india/?$ pvd-coating-plant-india/index.html [L]
</IfModule>

