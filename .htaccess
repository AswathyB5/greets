<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 301 permanent redirects for only these three old URLs
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+privacy\.html[\s?] [NC]
RewriteRule ^privacy\.html$ /privacy [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+contact\.html[\s?] [NC]
RewriteRule ^contact\.html$ /contact [R=301,L]

# Internal rewrites to serve clean URLs without .html extension
RewriteRule ^privacy/?$ privacy.html [L]
RewriteRule ^contact/?$ contact.html [L]
</IfModule>

