PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/greets_admin

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Set to "production" on the live server (makes the login cookie HTTPS-only)
NODE_ENV=development

# Folder of the website files (index.html, products.js, bmi/ ...). Publishing products writes here.
# Leave unset when the website folder is the parent of admin-server.
# SITE_DIR=C:/path/to/website

# Image uploads (optional). With all three set, pictures go to Cloudinary (free plan, no card);
# without them they are saved in admin-server/uploads. Find them in the Cloudinary dashboard.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- Going live ----------------------------------------------------------------------------
# The website address(es) allowed to read content and send the contact form to this server.
# Comma separated, no trailing slash. In production nothing else is allowed.
# ALLOWED_ORIGINS=https://www.greetsequipment.com,https://greetsequipment.com

# Set to 1 when this server is behind nginx / a load balancer (so spam limits see each visitor).
# TRUST_PROXY=1

# Address of the live website. Adds a "View website" link in the admin sidebar.
# SITE_PUBLIC_URL=https://www.greetsequipment.com

# ---- Email alerts for new enquiries (optional) -----------------------------------------------
# Any SMTP service works (Brevo, Gmail app password, your hosting's mail, Resend SMTP ...).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false          (true for port 465)
# MAIL_FROM="Greets Website <alerts@greetsequipment.com>"
# NOTIFY_EMAIL=sales@greetsequipment.com,owner@greetsequipment.com

# ---- Login ---------------------------------------------------------------------------------
# The login is the one written in config/defaultAdmin.js (or ADMIN_USERNAME / ADMIN_PASSWORD below).
# The "My account" and "Admins" screens (change / reset passwords) are switched OFF unless you set:
# ALLOW_ACCOUNT_MANAGEMENT=true
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# ---- Behaviour switches (all optional) ----------------------------------------------------------
# Products go live by themselves a moment after every save. AUTO_PUBLISH=false brings back the
# "Publish to website" button instead.
# AUTO_PUBLISH=true
# The Activity page (who changed what) and the My account / Admins screens are hidden. Set to true to show them.
# SHOW_ACTIVITY=false
# ALLOW_ACCOUNT_MANAGEMENT=false
# Where the copy of products.js / index.html / sitemap.xml taken before each publish is kept (default: admin-server/backups).
# BACKUP_DIR=
